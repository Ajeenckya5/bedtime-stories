# Rename to secrets.toml locally, or paste into Streamlit Cloud's Secrets box.
# NEVER commit secrets.toml - it is gitignored.

OPENAI_API_KEY = "sk-proj-..."

# Strongly recommended on a public deploy. Without this, anyone who finds the
# URL spends your OpenAI credit.
APP_PASSWORD = "pick-something"

BEDTIME_PROVIDER = "openai"
BEDTIME_MAX_USD_PER_DAY = "5.00"
BEDTIME_MAX_USD_PER_RUN = "0.10"
