# Copy to .env and fill in. .env is gitignored and never committed.
OPENAI_API_KEY=sk-your-key-here
BEDTIME_PROVIDER=openai          # or "mock" for an offline demo, no key needed
BEDTIME_ACCEPT_THRESHOLD=82
BEDTIME_JUDGE_SAMPLES=3
BEDTIME_MAX_REVISIONS=3
BEDTIME_MAX_USD_PER_RUN=0.25
BEDTIME_USE_MODERATION_API=true
BEDTIME_LOG_LEVEL=INFO

# --- story memory (continuity across sessions) ---
BEDTIME_MEMORY=true
BEDTIME_USE_EMBEDDINGS=true      # false => pure-stdlib TF-IDF, no second model
BEDTIME_EMBEDDING_MODEL=text-embedding-3-small
BEDTIME_MEMORY_TOP_K=4
BEDTIME_MEMORY_CONTEXT_WORDS=450

# --- cache ---
BEDTIME_ENABLE_CACHE=true
BEDTIME_CACHE_TTL_DAYS=14
BEDTIME_PLAN_CACHE=true
BEDTIME_STORY_CACHE=false        # true => repeat requests get the identical story

# --- narration (read the story aloud) ---
BEDTIME_TTS=true
BEDTIME_TTS_ENGINE=auto          # auto | openai | system (offline, free, robotic)
BEDTIME_TTS_VOICE=nova           # nova | shimmer | alloy | fable | echo | onyx
BEDTIME_TTS_SPEED=0.92           # under 1.0 = slower, calmer
